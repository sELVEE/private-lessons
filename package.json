{
  "name": "private-lessons",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @pl/api dev",
    "dev:web": "pnpm --filter @pl/web start",
    "db:generate": "pnpm --filter @pl/api db:generate",
    "db:migrate": "pnpm --filter @pl/api db:migrate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
