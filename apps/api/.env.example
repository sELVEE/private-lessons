NODE_ENV=development
PORT=3000
# Public URL of the web app; used in e-mail links and for the Origin check.
APP_URL=http://localhost:4200
DATABASE_URL=postgres://pl:pl@localhost:5432/private_lessons
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this comes from the secret manager, never from a committed file.
DATA_ENCRYPTION_KEY=
# HMAC key for hashing tokens / identifiers, 32 random bytes base64.
TOKEN_HASH_KEY=
# false only for local http development
COOKIE_SECURE=false
# smtp | log
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Korepetycje <no-reply@localhost>"
# Check new passwords against Have I Been Pwned (k-anonymity, only 5 hash chars leave the server)
HIBP_ENABLED=true
# Web Push (lesson reminders on phones). Generated by `pnpm setup:env`; leave empty to disable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
